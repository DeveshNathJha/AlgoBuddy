# ─── AlgoBuddy environment ───────────────────────────────────────────────
# THIS FILE IS PUBLIC (it is committed to GitHub). Keep every value here EMPTY.
# Put real keys in .env.local (git-ignored) for local dev, and in Vercel for production.
# Copy to .env.local for local dev. In Vercel: Project → Settings → Environment Variables.

# Server-side AI keys that power the FREE requests for signed-in users.
# Users who add their own key in Settings never touch these.
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENAI_API_KEY=""

# Free AI requests per verified account (default 15). Each Thinking Guide,
# Interview Script, Check & Fix or Explain Step costs 1.
NEXT_PUBLIC_FREE_AI_REQUESTS="15"

# REQUIRED in production: signs the login cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# REQUIRED in production: persistent store for OTPs, sessions' quota and rate limits.
# Easiest: Vercel → Storage → Upstash for Redis (free tier) — it sets these two automatically.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Google Sign-In (recommended). Create an OAuth 2.0 Web Client ID in Google Cloud Console
# and add your Vercel domain as an Authorized JavaScript origin.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Email OTP sign-in (optional). Without a verified domain, Resend can only email YOU,
# so verify a domain at resend.com/domains and set RESEND_FROM to an address on it.
RESEND_API_KEY=""
RESEND_FROM="AlgoBuddy <login@yourdomain.com>"
